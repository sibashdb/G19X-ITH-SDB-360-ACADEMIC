# Copie este archivo como infra/.env y cambie los valores.
# Use solo letras, números y guiones: los valores se insertan en URLs de conexión.
POSTGRES_PASSWORD=cambiar-postgres
PROVEEDORES_DB_PASSWORD=cambiar-proveedores
KEYCLOAK_DB_PASSWORD=cambiar-keycloak
KEYCLOAK_ADMIN_PASSWORD=cambiar-admin-keycloak
RABBITMQ_PASSWORD=cambiar-rabbitmq
ADMINISTRACION_DB_PASSWORD=cambiar-administracion
ADMINISTRACION_DUENO_DB_PASSWORD=cambiar-administracion-dueno
INTELIGENCIA_DB_PASSWORD=cambiar-inteligencia
INTELIGENCIA_DUENO_DB_PASSWORD=cambiar-inteligencia-dueno
NEGOCIACION_DB_PASSWORD=cambiar-negociacion
NEGOCIACION_DUENO_DB_PASSWORD=cambiar-negociacion-dueno
KEYCLOAK_ADMINISTRACION_SECRET=cambiar-secreto-administracion
# Versión que muestra la pantalla Estado del sistema (por ejemplo, el commit corto); es opcional.
VERSION_APP=desarrollo
